---
import Base from "@/layouts/Base.astro";

// AI-Generated
/** bookkeeping.astro — flagship page for the Bookkeeping service line
 *  (renamed from managed-accounting.astro / Managed Accounting). Hardcoded
 *  data arrays in frontmatter, matching the pattern in staffing.astro. Navy
 *  accent throughout; .bg-accent-panel used exactly once for the platform
 *  band. Single flat price, no tiers.
 *
 *  "How it works" uses custom markup rather than the shared ProcessStep
 *  component — this page needs small teal numbered circles instead of
 *  ProcessStep's large faded corner numbers, and ProcessStep is also used
 *  by staffing.astro so it isn't changed here.
 */
const trustCards = [
  {
    title: "Accurate, Every Time.",
    body: "An accountant reviews every entry before it reaches your statements.",
  },
  {
    title: "Someone Who Picks Up.",
    body: "One dedicated contact who knows your business. No ticket queues.",
  },
  {
    title: "Numbers You Understand.",
    body: "Clear monthly statements and a short summary of what changed and why.",
  },
  {
    title: "Ready for Your CPA.",
    body: "Clean, organized books at year-end. No scrambling at tax season.",
  },
];

const servicesItems = [
  {
    title: "Transactions",
    body: "Every purchase and deposit sorted into the right category.",
  },
  {
    title: "Reconciliations",
    body: "Your bank and card accounts matched to your books.",
  },
  {
    title: "Bills",
    body: "Entered and ready for you to approve and pay.",
  },
  {
    title: "Invoicing",
    body: "Invoices sent and payments tracked.",
  },
  {
    title: "Month-End Close",
    body: "Your books finalized every month.",
  },
  {
    title: "Financial Statements",
    body: "Profit and loss, balance sheet and cash flow, delivered monthly.",
  },
];

const howItWorks = [
  {
    step: 1,
    title: "Assessment",
    description:
      "We review your books and quote a fixed monthly price upfront.",
  },
  {
    step: 2,
    title: "Free Setup",
    description:
      "We set everything up and bring over your history at no cost.",
  },
  {
    step: 3,
    title: "Catch-Up",
    description: "If your books are behind, we bring them current first.",
  },
  {
    step: 4,
    title: "Ongoing",
    description:
      "Books updated continuously, with statements delivered every month.",
  },
];

const platformPoints = [
  {
    heading: "Same Price or Less",
    body: "Caytava costs the same as or less than QuickBooks, Xero, etc.",
  },
  {
    heading: "Free, Easy Switch",
    body: "We move everything over for you. No data entry, no learning curve.",
  },
  {
    heading: "Accountants in Charge",
    body: "The software handles the routine work. Our team reviews every entry.",
  },
];
// End AI-Generated
---

<Base
  title="Outsourced Bookkeeping from $500/mo | Cayto Group"
  meta_title="Outsourced Bookkeeping from $500/mo | Cayto Group"
  description="Clean, tax-ready books every month. Cayto Group handles your bookkeeping start to finish, from $500 per month with no setup fees."
>
  <!-- Hero -->
  <!-- AI-Generated -->
  <section class="section bg-dot-grid pb-[50px]">
    <div class="container">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="font-bold">Clean, Tax-Ready Books. Every Month.</h1>
        <p class="text-text mt-4">
          We handle everything, start to finish, for a fraction of what a
          local firm charges. You'll never have to think about your books
          again.
        </p>
        <a class="btn btn-accent mt-8 inline-block" href="/contact"
          >Get a Free Assessment</a
        >

        <div
          class="border-border bg-light mx-auto mt-10 grid grid-cols-1 gap-4 rounded-xl border sm:grid-cols-3 sm:gap-0 sm:divide-x sm:divide-border"
        >
          <div
            class="flex flex-col items-center justify-center px-8 py-6 text-center"
          >
            <span class="text-accent text-3xl font-bold whitespace-nowrap"
              >From $500</span
            >
            <span
              class="text-text mt-1 text-sm font-semibold tracking-wide uppercase"
              >Fixed Monthly Price</span
            >
          </div>
          <div
            class="flex flex-col items-center justify-center px-8 py-6 text-center"
          >
            <span class="text-accent text-3xl font-bold whitespace-nowrap"
              >$0</span
            >
            <span
              class="text-text mt-1 text-sm font-semibold tracking-wide uppercase"
              >Setup Fees</span
            >
          </div>
          <div
            class="flex flex-col items-center justify-center px-8 py-6 text-center"
          >
            <span class="text-accent text-3xl font-bold whitespace-nowrap"
              >Always</span
            >
            <span
              class="text-text mt-1 text-sm font-semibold tracking-wide uppercase"
              >Up to Date</span
            >
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <!-- Books You Can Trust -->
  <!-- AI-Generated -->
  <section class="section bg-body">
    <div class="container">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="font-bold lg:whitespace-nowrap">Books You Can Trust</h2>
      </div>
      <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {
          trustCards.map((card) => (
            <div class="feature-card border-accent rounded-xl border-t-4 bg-white p-6 pb-10">
              <p class="h5">{card.title}</p>
              <p class="text-text mt-3">{card.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <!-- Built Around What You Need -->
  <!-- AI-Generated -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="font-bold">Built Around What You Need</h2>
      </div>
      <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          servicesItems.map((item) => (
            <div class="feature-card flex flex-col items-center rounded-xl bg-white p-6 pb-8 text-center">
              <img
                src="/images/icons/checkmark-circle.svg"
                alt=""
                width="32"
                height="32"
              />
              <p class="h5 mt-4">{item.title}</p>
              <p class="text-text mt-2">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <!-- Up and Running in Weeks -->
  <!-- AI-Generated -->
  <section class="section bg-body">
    <div class="container">
      <div class="mb-12 text-center">
        <h2 class="font-bold">Up and Running in Weeks</h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          howItWorks.map((s) => (
            <div class="feature-card flex flex-col items-center rounded-xl bg-white p-6 pb-10 text-center">
              <span class="bg-primary flex h-8 w-8 items-center justify-center rounded-full text-sm font-bold text-white">
                {s.step}
              </span>
              <p class="h5 mt-4">{s.title}</p>
              <p class="text-text mt-3">{s.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <!-- Platform band -->
  <!-- AI-Generated -->
  <section class="section bg-accent-panel">
    <div class="container">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-bold">Smarter Software. Real Accountants.</h2>
        <p class="mt-6">
          Your books run on Caytava, our preferred AI-powered accounting
          platform. Having every client on one system is how we keep your
          books accurate, up to date and affordable. Your account and your
          data stay yours, even if you stop working with us.
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-4xl gap-8 text-center sm:grid-cols-3">
        {
          platformPoints.map((item) => (
            <div>
              <p class="font-bold">{item.heading}</p>
              <p class="mt-2">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <!-- Closing CTA -->
  <!-- AI-Generated — Cta.astro hardcodes .btn-primary; authored inline with .btn-accent -->
  <section class="section px-4">
    <div class="section bg-light container rounded-xl shadow">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-bold lg:whitespace-nowrap">
          Let's Get Your Books Handled.
        </h2>
        <p class="text-text mt-4">
          Tell us where things stand, even if it's a shoebox of receipts.
          We'll review it, give you a fixed monthly price and let you know if
          we're a good fit.
        </p>
        <a class="btn btn-accent mt-6 inline-block" href="/contact"
          >Get a Free Assessment</a
        >
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->
</Base>
