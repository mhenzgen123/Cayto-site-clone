---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { render } from "astro:content";

export async function getStaticPaths() {
  const pages = await getSinglePage("pages");

  // AI-Generated
  // Exclude pages that have dedicated .astro routes to avoid route conflicts
  // at build time. Astro resolves static routes before dynamic ones, so these
  // three slugs would otherwise be generated twice and cause a build warning.
  const excludedIds = ["about-us", "our-services", "pricing"];
  const paths = pages
    .filter((page) => !excludedIds.includes(page.id))
    .map((page) => ({
      params: {
        regular: page.id,
      },
      props: { page },
    }));
  // End AI-Generated
  return paths;
}

const { page } = Astro.props;
const { title, meta_title, description, image } = page.data;
const { Content } = await render(page);
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <section class="section bg-dot-grid border-y border-border">
    <div class="container">
      <h1 set:html={markdownify(title)} class="h2 mb-8 text-center" />
      <div class="content">
        <Content />
      </div>
    </div>
  </section>
</Base>
