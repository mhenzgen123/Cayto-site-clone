---
import Base from "@/layouts/Base.astro";
import ProcessStep from "@/layouts/components/ProcessStep.astro";

// AI-Generated
/** managed-accounting.astro — flagship page for the new Managed Accounting
 *  service line. Hardcoded data arrays in frontmatter, matching the pattern
 *  in staffing.astro. Navy accent throughout; .bg-accent-panel used exactly
 *  once for the AI/Caytava band.
 */
const whoFor = [
  {
    title: "You are the accountant, and you shouldn't be",
    body: "The owner or one of the operators is doing the books at night, in a spreadsheet, or in QuickBooks that no one has reconciled since spring. It works until it doesn't.",
  },
  {
    title: "Your bookkeeper left, or never really fit",
    body: "You had someone part-time or a local firm, and the books are late, wrong, or both. You need it to just work without hiring and managing another person.",
  },
  {
    title: "You are growing and the numbers stopped being reliable",
    body: "Revenue is up, transaction volume is up, and the monthly numbers no longer tell you anything you can act on. You need a real close, not a categorized bank feed.",
  },
];

const included = [
  {
    title: "Transaction categorization",
    body: "Every bank and credit card line captured, coded, and posted to the correct account",
  },
  {
    title: "Reconciliations",
    body: "Bank, credit card, and balance sheet accounts reconciled continuously, not in a month-end scramble",
  },
  {
    title: "Accounts payable",
    body: "Bills captured and coded, payment runs prepared for your approval, vendor records kept current",
  },
  {
    title: "Accounts receivable",
    body: "Invoices issued, cash applied, AR aging maintained and reviewed with you",
  },
  {
    title: "Month-end close",
    body: "Accruals, prepaids, fixed assets and depreciation, and any recurring entries your business requires",
  },
  {
    title: "Financial statements",
    body: "Profit and loss, balance sheet, and cash flow, delivered on a fixed monthly schedule",
  },
  {
    title: "Management reporting",
    body: "A monthly package with the numbers in context, so the statements are usable and not just filed",
  },
  {
    title: "Year-end handoff",
    body: "A clean, tax-ready package delivered to your CPA — no spring scramble, no reconstruction",
  },
];

const howItWorks = [
  {
    step: 1,
    title: "Assessment",
    description:
      "We look at where your books actually stand — what system you are on, how far behind you are, and what your volume really is. You get an honest scope and a fixed monthly price before you commit to anything.",
  },
  {
    step: 2,
    title: "Setup and migration",
    description:
      "We configure your chart of accounts, connect your bank and card feeds, and migrate your history. Cayto handles implementation end to end. You are not doing data entry.",
  },
  {
    step: 3,
    title: "Cleanup",
    description:
      "If the books need catching up, we bring them current before steady-state begins. Cleanup is billed at the same monthly rate for each month brought current, so there is no surprise project fee.",
  },
  {
    step: 4,
    title: "Steady state",
    description:
      "Transactions flow in and get coded continuously. We close each month on a fixed schedule and deliver your financial statements. You have one named point of contact, and you always know who to call.",
  },
];

const aiRow = [
  {
    heading: "Automated capture and coding",
    body: "Bank feeds, cards, bills, receipts, and invoices come in and get coded without manual keying",
  },
  {
    heading: "Continuous reconciliation",
    body: "Accounts stay reconciled as transactions flow, so the close is a review rather than a rebuild",
  },
  {
    heading: "Human approval on every entry",
    body: "A Cayto accountant reviews and approves before anything posts. No unattended AI writes to your ledger",
  },
];

const trustCards = [
  {
    title: "A U.S. principal owns your engagement",
    body: "Every Managed Accounting client has a U.S.-based Cayto principal accountable for the work, and a named day-to-day point of contact on the delivery team. You are never routed to a queue.",
  },
  {
    title: "Reviewed before it is delivered",
    body: "Nothing reaches your financial statements without review by a qualified Cayto accountant. Our professionals hold recognized accounting credentials, and over 70% have Big 4 experience.",
  },
  {
    title: "Screened and verified",
    body: "Every Cayto professional passes reference checks, prior employer verification, and full background screening before touching client work. That is a standard step in our six-stage process, not an add-on.",
  },
  {
    title: "You contract with a U.S. company",
    body: "You engage Cayto Group LLC, a U.S.-based limited liability company. You receive a U.S. invoice, a W-9, and a fixed monthly rate, and you retain full ownership of your financial data and work product.",
  },
];

const pricingTiers = [
  {
    tier: "Tier 1",
    volume: "Under 100 transactions per month",
    price: "$500",
    featured: false,
  },
  {
    tier: "Tier 2",
    volume: "100 to 250 transactions per month",
    price: "$750",
    featured: true,
  },
  {
    tier: "Tier 3",
    volume: "250+ transactions per month",
    price: "$1,000",
    featured: false,
  },
];
// End AI-Generated
---

<Base
  title="Managed Accounting | Cayto Group"
  meta_title="Managed Accounting | Cayto Group"
  description="Full-cycle bookkeeping through financial statements, run by Cayto's team on an AI-native platform with U.S. review. From $500 per month."
>
  <!-- Hero -->
  <!-- AI-Generated -->
  <section class="section bg-dot-grid pb-[50px]">
    <div class="container">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-accent text-xs font-semibold tracking-widest uppercase">
          Managed Accounting
        </p>
        <h1 class="mt-3 font-bold">Your books, handled. Start to finish.</h1>
        <p class="text-text mt-4">
          You did not start a company to run an accounting department. Cayto's
          team takes the whole cycle — transactions, reconciliations, AP, AR,
          close, and financial statements — and delivers accurate financials
          every month. Built on AI-native tooling, reviewed by U.S.-based
          accountants, at roughly half what a local bookkeeper costs.
        </p>
        <a class="btn btn-accent mt-8 inline-block" href="/contact"
          >Get Started</a
        >

        <div
          class="border-border bg-light sm:divide-border mx-auto mt-10 flex flex-col items-center justify-center gap-4 rounded-xl border px-8 py-6 sm:flex-row sm:gap-0 sm:divide-x"
        >
          <div class="flex flex-col items-center px-8 text-center">
            <span class="text-accent text-3xl font-bold">From $500</span>
            <span
              class="text-text mt-1 text-sm font-semibold tracking-wide uppercase"
              >Per Month</span
            >
          </div>
          <div class="flex flex-col items-center px-8 text-center">
            <span class="text-accent text-3xl font-bold">Monthly</span>
            <span
              class="text-text mt-1 text-sm font-semibold tracking-wide uppercase"
              >Financial Statements</span
            >
          </div>
          <div class="flex flex-col items-center px-8 text-center">
            <span class="text-accent text-3xl font-bold">U.S.</span>
            <span
              class="text-text mt-1 text-sm font-semibold tracking-wide uppercase"
              >Reviewed &amp; Approved</span
            >
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <!-- U.S. oversight and trust — moved up to directly follow the hero -->
  <!-- AI-Generated -->
  <section class="section bg-body">
    <div class="container">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="font-bold">Hybrid Onshore/Offshore delivery</h2>
        <p class="text-text mt-4">
          The same standards that govern our staffing engagements apply here,
          because it is the same firm and the same people.
        </p>
      </div>
      <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {
          trustCards.map((card) => (
            <div class="feature-card border-accent rounded-xl border-t-4 bg-white p-6 pb-10">
              <p class="h5">{card.title}</p>
              <p class="text-text mt-3">{card.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  {
    /* "Who this is for" — disabled per client request (2026-07-30), kept
       here so it can be re-enabled later. Flip `false` to `true` to bring
       it back; nothing else needs to change. */
  }
  {
    false && (
      <section class="section bg-body">
        <div class="container">
          <div class="mx-auto mb-12 max-w-2xl text-center">
            <h2 class="font-bold">
              Built for companies without an accounting department
            </h2>
            <p class="text-text mt-4">
              If you have a Controller and need more capacity, our{" "}
              <a class="text-primary hover:underline" href="/staffing">
                staffing line
              </a>{" "}
              is the better fit. Managed Accounting is for everyone else.
            </p>
          </div>
          <div class="grid gap-x-8 gap-y-6 sm:grid-cols-3">
            {whoFor.map((card) => (
              <div class="feature-card border-accent rounded-xl border-t-4 bg-white p-6 pb-10">
                <p class="h5">{card.title}</p>
                <p class="text-text mt-3">{card.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- What's included -->
  <!-- AI-Generated -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="font-bold">
          A full accounting cycle, not a categorized bank feed
        </h2>
        <p class="text-text mt-4">
          Every tier includes everything below. Price varies on volume, not on
          scope.
        </p>
      </div>
      <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          included.map((item) => (
            <div class="feature-card rounded-xl bg-white p-6 pb-8">
              <img
                src="/images/icons/checkmark-circle.svg"
                alt=""
                width="32"
                height="32"
              />
              <p class="h5 mt-4">{item.title}</p>
              <p class="text-text mt-2">{item.body}</p>
            </div>
          ))
        }
      </div>
      <div
        class="inset-panel border-border mt-10 rounded-xl border bg-white p-8"
      >
        <p class="text-text">
          <strong class="text-text-dark">What this is not.</strong>
          Managed Accounting does not include tax return preparation or filing. We
          keep your books tax-ready year-round and hand a clean package to your CPA.
          If you do not have one, we can point you in the right direction.
        </p>
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <!-- How it works -->
  <!-- AI-Generated -->
  <section class="section bg-body">
    <div class="container">
      <div class="mb-12 text-center">
        <h2 class="font-bold">From messy to current, usually within weeks</h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          howItWorks.map((s) => (
            <ProcessStep
              step={s.step}
              title={s.title}
              description={s.description}
              accent="accent"
            />
          ))
        }
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <!-- The AI and platform band -->
  <!-- AI-Generated -->
  <section class="section bg-accent-panel">
    <div class="container">
      <div class="mx-auto max-w-4xl text-center">
        <p
          class="text-xs font-semibold tracking-widest text-white/70 uppercase"
        >
          How We Deliver It for This Price
        </p>
        <h2 class="mt-3 font-bold">
          The busywork is automated. The judgment is not.
        </h2>
        <p class="mt-6">
          A traditional bookkeeper spends most of the month keying transactions,
          matching receipts to charges, chasing missing documents, and
          reconciling accounts by hand. That work is now largely automatable,
          and we built this service around that fact rather than bolting
          software onto an old process.
        </p>
        <p class="mt-4">
          Documents and feeds are captured and coded automatically.
          Reconciliation runs continuously instead of accumulating until
          month-end. Duplicates, anomalies, and miscodings surface for review
          the day they happen rather than three weeks later. What remains is the
          work that genuinely requires an accountant — and a Cayto professional
          reviews and approves every entry before it posts to your books.
          Nothing an AI drafts becomes a record on its own.
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-4xl gap-8 sm:grid-cols-3">
        {
          aiRow.map((item) => (
            <div class="text-center sm:text-left">
              <p class="font-bold">{item.heading}</p>
              <p class="mt-2">{item.body}</p>
            </div>
          ))
        }
      </div>

      <div
        class="mx-auto mt-10 max-w-4xl border-t border-white/15 pt-10 text-center"
      >
        <p class="font-bold">Our preferred platform partner</p>
        <p class="mt-4">
          Managed Accounting runs on <strong>Caytava</strong>, an AI-native
          accounting platform built by our sister company. One ledger carries
          accounting and close, payments, AP, AR, and reporting, which means
          your books, your bills, and your invoices stop living in four systems
          that have to be reconciled to each other.
        </p>
        <p class="mt-4">
          Cayto Group delivers the service — implementation, migration,
          bookkeeping, close, and reporting. Caytava provides the platform, and
          you subscribe to it directly.
        </p>
        <a
          class="btn btn-on-dark mt-6 inline-block"
          href="https://www.caytava.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          Visit Caytava →
        </a>
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <!-- Pricing -->
  <!-- AI-Generated -->
  <section id="pricing" class="section bg-light">
    <div class="container">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="font-bold">
          Simple pricing. Priced on volume, not on scope.
        </h2>
        <p class="text-text mt-4">
          Every tier includes the full accounting cycle described above. The
          only variable is how many transactions you run.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        {
          pricingTiers.map((t) => (
            <div
              class={`pricing-card ${t.featured ? "pricing-card--featured" : ""}`}
            >
              {t.featured && (
                <p class="text-accent mb-2 text-xs font-semibold tracking-widest uppercase">
                  Most common
                </p>
              )}
              <p class="h5">{t.tier}</p>
              <p class="text-text mt-2 text-sm">{t.volume}</p>
              <p class="text-accent mt-6 text-5xl font-bold">{t.price}</p>
              <p class="text-text">/ month</p>
              <p class="text-text mt-6 text-sm">Full accounting cycle</p>
              <p class="text-text-dark mt-6 text-sm font-semibold">
                Everything above is included at every tier.
              </p>
            </div>
          ))
        }
      </div>

      <div
        class="inset-panel border-border mx-auto mt-10 max-w-4xl space-y-4 rounded-xl border bg-white p-8"
      >
        <p class="text-text">
          <strong class="text-text-dark">What counts as a transaction.</strong>
          A transaction is a bank or credit card line item categorized in a given
          month. We size your tier from your actual statements during the assessment,
          and we tell you before we start — not after.
        </p>
        <p class="text-text">
          <strong class="text-text-dark"
            >The platform is billed separately.</strong
          >
          Your Caytava subscription is billed directly by Caytava. It typically costs
          less than what companies pay today for QuickBooks or Xero, and it can often
          be included at no cost as part of a managed engagement. Ask us.
        </p>
        <p class="text-text">
          <strong class="text-text-dark"
            >Catching up is billed the same way.</strong
          >
          If your books are behind, cleanup is billed at your monthly rate for each
          month brought current. No separate project fee.
        </p>
      </div>

      <div class="mx-auto mt-10 max-w-2xl text-center">
        <p class="text-text">
          <strong class="text-text-dark"
            >Compare that to the alternative.</strong
          >
          A local bookkeeping firm typically runs $2,000 to $4,000 a month for this
          scope, and a full-time in-house bookkeeper costs $55,000 to $75,000 a year
          fully burdened. Same output, roughly half the cost — or better.
        </p>
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <!-- Closing CTA -->
  <!-- AI-Generated — Cta.astro hardcodes .btn-primary; authored inline with .btn-accent -->
  <section class="section px-4">
    <div class="section bg-light container rounded-xl shadow">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-bold">Let's get your books handled.</h2>
        <p class="text-text mt-4">
          Tell us where things stand today, even if the honest answer is "a
          shoebox." We will assess it, quote a fixed monthly price, and tell you
          plainly whether we are the right fit.
        </p>
        <a class="btn btn-accent mt-6 inline-block" href="/contact"
          >Get Started</a
        >
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->
</Base>
