// AI-Generated
/** staffing.astro — dedicated Dedicated Professionals page with six-stage selection
 *  process grid, talent tier tabs, security cards, and shared CTA.
 *  Bypasses the generic [regular].astro route. Renamed from our-services.astro;
 *  /our-services now 301s here via public/_redirects.
 */
const selectionSteps = [
  {
    step: 1,
    title: "Screening",
    description:
      "We review hundreds of resumes, filtering out candidates who do not meet our minimum requirements.",
  },
  {
    step: 2,
    title: "Assessment",
    description:
      "Our local team interviews candidates to validate technical skills, experience, and overall background.",
  },
  {
    step: 3,
    title: "Communication",
    description:
      "Candidates meet with our U.S. Principals for an evaluation of their critical thinking & communication skills.",
  },
  {
    step: 4,
    title: "Validation",
    description:
      "Remaining candidates take a timed, CPA exam-level assessment to further ensure their knowledge and expertise.",
  },
  {
    step: 5,
    title: "Verification",
    description:
      "We conduct background checks and validate prior employer references to ensure integrity and professionalism.",
  },
  {
    step: 6,
    title: "Onboarding",
    description:
      "Successful candidates join Cayto Group's bench, ready to interview for new client engagements.",
  },
];

const tiers = [
  {
    label: "Tier 1",
    roles: [
      "A/P Clerk",
      "A/R Specialist",
      "Staff Accountant",
      "Accounting Analyst",
    ],
    experience: ["3–5 years of public or private industry accounting"],
    certifications: ["AAT", "CA (In-Progress)"],
  },
  {
    label: "Tier 2",
    roles: [
      "Senior Accountant",
      "GL Accountant",
      "Financial Analyst",
      "Revenue Accountant",
    ],
    experience: ["6-10 Years", "Mix of public and private", "Big 4"],
    certifications: ["CA", "CMA", "CIMA", "ACCA"],
  },
  {
    label: "Tier 3",
    roles: [
      "Accounting Manager",
      "AP/AR Manager",
      "FP&A Manager",
      "Controller",
    ],
    experience: ["10+ Years", "Mix of public and private", "Big 4"],
    certifications: ["CA", "CPA", "CMA", "CIMA", "ACCA"],
  },
];

const skillSets = [
  "Royalty Accountant",
  "Inventory Accountant",
  "Cost Accountant",
  "Fund Accountant",
  "Insurance Accountant",
  "Not-for-profit Accountant",
  "Property Management Accountant",
  "Lease Accountant",
];

const cta = {
  title:
    "Add dedicated, fully vetted accounting professionals to your team. We present multiple candidates and you choose.",
  content:
    "Integrate dedicated, skilled accounting professionals into your team. Cayto Group delivers vetted talent, tailored to your needs, for immediate impact.",
  button: { enable: true, label: "Find Your Finance Expert", link: "/contact" },
};
// End AI-Generated
---

<Base
  title="Dedicated Professionals | Cayto Group"
  meta_title="Dedicated Professionals | Cayto Group"
  description="Dedicated, fully vetted offshore accounting professionals embedded on your team. Six-stage screening, Big 4-caliber talent, roughly half the cost of a U.S. hire."
>
  <!-- Hero -->
  <!-- AI-Generated -->
  <section class="section bg-dot-grid pb-[50px]">
    <div class="container">
      <div class="mb-12 text-center">
        <h1 class="font-bold">Dedicated Accounting Professionals</h1>
        <p class="text-text mx-auto mt-3 max-w-2xl">
          Fully vetted, background-screened accounting and finance professionals
          — exclusive to your team, managed by you, at roughly half the cost of
          an equivalent U.S. hire.
        </p>

        <div
          class="border-border bg-light sm:divide-border mx-auto mt-8 flex flex-col items-center justify-center gap-4 rounded-xl border px-8 py-6 sm:flex-row sm:gap-0 sm:divide-x"
        >
          <div class="flex flex-col items-center px-8 text-center">
            <span class="text-primary text-3xl font-bold">65%+</span>
            <span
              class="text-text mt-1 text-sm font-semibold tracking-wide uppercase"
              >Annual Cost Savings</span
            >
          </div>
          <div class="flex flex-col items-center px-8 text-center">
            <span class="text-primary text-3xl font-bold">14-Day</span>
            <span
              class="text-text mt-1 text-sm font-semibold tracking-wide uppercase"
              >Replacement Guarantee</span
            >
          </div>
          <div class="flex flex-col items-center px-8 text-center">
            <span class="text-primary text-3xl font-bold">3-Month</span>
            <span
              class="text-text mt-1 text-sm font-semibold tracking-wide uppercase"
              >Initial Contract Only</span
            >
          </div>
        </div>
      </div>

      <div class="mb-12 text-center">
        <h2 class="font-bold">Our Selection Process</h2>
        <p class="mt-3">
          Every candidate who reaches your inbox has cleared all six stages.
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          selectionSteps.map((s) => (
            <ProcessStep
              step={s.step}
              title={s.title}
              description={s.description}
            />
          ))
        }
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <!-- Talent Tiers — Tabs -->
  <!-- AI-Generated -->
  <section class="section">
    <div class="container">
      <div class="mb-12 text-center">
        <h2 class="font-bold">Explore Our Talent by Role & Skill Set</h2>
      </div>
      <div class="tab">
        <ul class="tab-nav justify-center">
          {
            tiers.map((tier, i) => (
              <li class={`tab-nav-item${i === 0 ? " active" : ""}`}>
                {tier.label}
              </li>
            ))
          }
        </ul>
        {
          tiers.map((tier, i) => (
            <div class={`tab-content-panel${i === 0 ? " active" : ""}`}>
              <div class="grid gap-8 pt-8 md:grid-cols-3">
                <div>
                  <h5 class="mb-3 font-bold">Typical Roles</h5>
                  <ul class="list-none space-y-2 pl-0">
                    {tier.roles.map((role) => (
                      <li class="text-text before:bg-primary relative pl-5 before:absolute before:top-[10px] before:left-0 before:h-2 before:w-2 before:rounded-full before:content-['']">
                        {role}
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h5 class="mb-3 font-bold">Experience</h5>
                  <ul class="list-none space-y-2 pl-0">
                    {tier.experience.map((item) => (
                      <li class="text-text before:bg-primary relative pl-5 before:absolute before:top-[10px] before:left-0 before:h-2 before:w-2 before:rounded-full before:content-['']">
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h5 class="mb-3 font-bold">Certifications</h5>
                  <ul class="list-none space-y-2 pl-0">
                    {tier.certifications.map((cert) => (
                      <li class="text-text before:bg-primary relative pl-5 before:absolute before:top-[10px] before:left-0 before:h-2 before:w-2 before:rounded-full before:content-['']">
                        {cert}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Specialized Skill Sets -->
      <div
        class="inset-panel bg-light border-border mt-10 rounded-xl border p-8"
      >
        <h4 class="mb-4 font-bold">Specialized Skill Sets</h4>
        <ul class="grid list-none gap-2 pl-0 sm:grid-cols-2 md:grid-cols-4">
          {
            skillSets.map((role) => (
              <li class="text-text before:bg-primary relative pl-5 before:absolute before:top-[10px] before:left-0 before:h-2 before:w-2 before:rounded-full before:content-['']">
                {role}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <!-- Tab interactivity — progressive enhancement, no framework dependency -->
  <!-- AI-Generated -->
  <script>
    /** Wires up tab navigation within .tab components.
     *  Activates the clicked nav item and its corresponding content panel by index.
     *
     *  Runs both immediately (handles the case where this module script loads AFTER
     *  astro:page-load has already fired for the current navigation) and on every
     *  future astro:page-load (handles ClientRouter soft-navigations).
     *  Using both guards against Astro module script / event timing edge cases.
     */
    function initTabs() {
      const navItems = document.querySelectorAll<HTMLElement>(".tab-nav-item");
      const panels =
        document.querySelectorAll<HTMLElement>(".tab-content-panel");
      if (!navItems.length) return;
      navItems.forEach((item, index) => {
        item.addEventListener("click", () => {
          navItems.forEach((n) => n.classList.remove("active"));
          panels.forEach((p) => p.classList.remove("active"));
          item.classList.add("active");
          panels[index]?.classList.add("active");
        });
      });
    }

    // Immediate call: handles when this script loads after astro:page-load
    initTabs();
    // Listener: handles every subsequent soft-navigation to this page
    document.addEventListener("astro:page-load", initTabs);
  </script>
  <!-- End AI-Generated -->

  <!-- Trusted By logo strip -->
  <LogoWall />

  <!-- Modern Tooling — light AI touch, pre-empts the "won't AI replace this role" objection -->
  <!-- AI-Generated -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-primary text-xs font-semibold tracking-widest uppercase">
          Modern Tooling
        </p>
        <h2 class="mt-3 font-bold">
          Professionals who work the way finance works now
        </h2>
        <p class="text-text mt-6">
          Automation is changing what an accountant spends their day doing. Our
          professionals are trained on AI-enabled accounting workflows —
          automated document intake and coding, continuous reconciliation, and
          anomaly review — so the person you place is spending their time on
          judgment and analysis rather than keying and matching.
        </p>
        <p class="text-text mt-4">
          It also means they adapt to your stack rather than resisting it.
          NetSuite, Sage Intacct, QuickBooks Online, Xero, Bill.com, and
          whatever you adopt next.
        </p>
        <a
          class="text-primary mt-6 inline-flex items-center gap-1 font-semibold hover:underline"
          href="/managed-accounting"
        >
          Want the whole function handled instead? See Managed Accounting →
        </a>
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <!-- Testimonials -->
  <Testimonials />

  <Cta cta={cta} />
</Base>
