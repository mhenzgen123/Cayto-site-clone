---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Cta from "@/layouts/components/Cta.astro";
import LogoWall from "@/layouts/components/LogoWall.astro";
import Testimonials from "@/layouts/components/Testimonials.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";

const homepage = (await getEntry(
  "homepage",
  "-index",
)) as CollectionEntry<"homepage">;
const { banner, feature, call_to_action } = homepage.data;
---

<Base
  title="Cayto Group | Offshore Accounting Staffing & Bookkeeping"
  meta_title="Cayto Group | Offshore Accounting Staffing & Bookkeeping"
  description="Cayto Group places vetted offshore accounting professionals on your team and offers full-service bookkeeping, both at 65%+ less than doing it in-house."
>
  <!-- banner -->
  <section class="section bg-dot-grid pb-[50px]">
    <div class="container">
      <div class="row text-center">
        <div class="mx-auto lg:col-8">
          <h1 class="font-black whitespace-pre-line">{banner?.title}</h1>
          {
            banner?.content && (
              <p class="mt-4" set:html={markdownify(banner.content)} />
            )
          }

          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a
              class="btn btn-primary min-w-[220px] text-center"
              href="/staffing">Explore Staffing</a
            >
            <a
              class="btn btn-accent min-w-[220px] text-center"
              href="/bookkeeping">Explore Bookkeeping</a
            >
          </div>

          <div
            class="border-border bg-light sm:divide-border mx-auto mt-10 flex flex-col items-center justify-center gap-4 rounded-xl border px-8 py-6 sm:flex-row sm:gap-0 sm:divide-x"
          >
            <div class="flex flex-col items-center px-8 text-center">
              <span class="text-primary text-3xl font-bold whitespace-nowrap"
                >65%+</span
              >
              <span
                class="text-text mt-1 text-sm font-semibold tracking-wide uppercase"
                >Cost Savings</span
              >
            </div>
            <div class="flex flex-col items-center px-8 text-center">
              <span class="text-primary text-3xl font-bold whitespace-nowrap"
                >14-Day</span
              >
              <span
                class="text-text mt-1 text-sm font-semibold tracking-wide uppercase"
                >Guarantee Period</span
              >
            </div>
            <div class="flex flex-col items-center px-8 text-center">
              <span class="text-primary text-3xl font-bold whitespace-nowrap"
                >Short-Term</span
              >
              <span
                class="text-text mt-1 text-sm font-semibold tracking-wide uppercase"
                >Initial Contract</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trusted By logo strip -->
  <LogoWall eyebrow="Trusted by finance teams across the U.S." />

  <!-- Why Finance Leaders Choose Cayto -->
  <section class="section bg-light">
    <div class="container">
      <div class="text-center">
        {
          /* AI-Generated — set:html required; markdownify returns an HTML string, not plain text */
        }
        <h2 set:html={markdownify(feature.title)} />
        {/* End AI-Generated */}
      </div>
      <div class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          feature.features.map((item) => (
            <div class="feature-card rounded-xl bg-white p-6 pb-10 text-center shadow-sm">
              {item.icon && (
                <Image
                  class="mx-auto"
                  alt=""
                  src={item.icon}
                  width={40}
                  height={40}
                />
              )}
              <div class="mt-4">
                <h3 class="h5" set:html={markdownify(item.name)} />
                <p class="mt-3">{item.content}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What Our Clients Say -->
  <Testimonials />

  <!-- Call to Action -->
  <Cta cta={call_to_action} />
</Base>
