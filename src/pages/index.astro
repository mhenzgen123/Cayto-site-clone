---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Cta from "@/layouts/components/Cta.astro";
import LogoWall from "@/layouts/components/LogoWall.astro";
import Testimonials from "@/layouts/components/Testimonials.astro";
import ServiceDoor from "@/layouts/components/ServiceDoor.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";

const homepage = (await getEntry(
  "homepage",
  "-index",
)) as CollectionEntry<"homepage">;
const { banner, feature, call_to_action } = homepage.data;
---

<Base>
  <!-- banner -->
  <section class="section bg-dot-grid pb-[50px]">
    <div class="container">
      <div class="row text-center">
        <div class="mx-auto lg:col-8">
          <h1 class="font-black whitespace-pre-line">{banner?.title}</h1>
          {
            banner?.content && (
              <p class="mt-4" set:html={markdownify(banner.content)} />
            )
          }

          {
            banner?.button?.enable && (
              <a class="btn btn-primary mt-4" href={banner.button.link}>
                {banner.button.label}
              </a>
            )
          }

          {
            banner?.image && (
              <Image
                class="mx-auto mt-12"
                src={banner?.image}
                width={750}
                height={390}
                alt="banner image"
              />
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Two Ways to Work With Us -->
  <!-- AI-Generated -->
  <section class="section bg-light">
    <div class="container">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="font-bold">Two Ways to Work With Us</h2>
        <p class="text-text mt-4">
          The right answer depends on whether you already have someone leading
          accounting.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        <ServiceDoor
          accent="primary"
          eyebrow="Dedicated Professionals"
          title="Add capacity to the team you have"
          forWhom="For companies with a Controller, VP Finance, or CFO who need more hands — AP, AR, staff and senior accountants, or specialized roles — without the cost or the search."
          bullets={[
            "A dedicated professional, exclusive to you, managed by you",
            "Six-stage vetting including a CPA-level timed exam",
            "14-day replacement guarantee, three-month initial term",
          ]}
          href="/staffing"
          ctaLabel="Explore Staffing"
        />
        <ServiceDoor
          accent="accent"
          eyebrow="Managed Accounting"
          title="Hand us the books entirely"
          forWhom="For companies with no one leading accounting. We run the full cycle — transactions through financial statements — on an AI-native platform, reviewed by our U.S. team."
          bullets={[
            "Full-cycle bookkeeping through monthly financial statements",
            "AI handles the busywork; a Cayto accountant approves every entry",
            "From $500 per month, priced on transaction volume",
          ]}
          href="/managed-accounting"
          ctaLabel="Explore Managed Accounting"
        />
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <!-- Trusted By logo strip -->
  <LogoWall />

  <!-- Features -->
  <section class="section bg-light">
    <div class="container">
      <div class="text-center">
        {
          /* AI-Generated — set:html required; markdownify returns an HTML string, not plain text */
        }
        <h2 set:html={markdownify(feature.title)} />
        {/* End AI-Generated */}
      </div>
      <div class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          feature.features.map((item) => (
            <div class="feature-card rounded-xl bg-white p-6 pb-10 text-center shadow-sm">
              {item.icon && (
                <Image
                  class="mx-auto"
                  alt=""
                  src={item.icon}
                  width={40}
                  height={40}
                />
              )}
              <div class="mt-4">
                <h3 class="h5" set:html={markdownify(item.name)} />
                <p class="mt-3">{item.content}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How AI changes the economics -->
  <!-- AI-Generated -->
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-primary text-xs font-semibold tracking-widest uppercase">
          How We Deliver
        </p>
        <h2 class="mt-3 font-bold">
          The busywork is automated. The judgment is not.
        </h2>
        <p class="text-text mt-6">
          Most accounting cost is not judgment. It is keying, matching, chasing
          documents, and hunting down the reason two numbers disagree. That work
          is now largely automatable, and we have built our delivery around that
          fact.
        </p>
        <p class="text-text mt-4">
          Bank and card feeds, bills, receipts, and invoices are captured and
          coded automatically. Reconciliation runs continuously instead of
          piling up at month-end. Anomalies and duplicates get flagged for
          review rather than discovered three weeks later. What is left is the
          part that actually requires an accountant, and a Cayto professional
          reviews and approves every entry before it reaches your books.
        </p>
        <p class="text-text mt-4">
          That is how we deliver better work faster, at a price a traditional
          firm cannot match.
        </p>
        <a
          class="text-primary mt-6 inline-flex items-center gap-1 font-semibold hover:underline"
          href="/managed-accounting"
        >
          See how Managed Accounting works →
        </a>
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <!-- Testimonials -->
  <Testimonials />

  <!-- Call to Action -->
  <Cta cta={call_to_action} />
</Base>
