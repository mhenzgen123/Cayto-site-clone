          testimonials.map((t) => (
            <div class="rounded-xl bg-white p-8 flex flex-col testimonial-card border-t-4 border-primary">
              <p
                class="text-6xl font-bold text-primary leading-none mb-2 select-none"
                aria-hidden="true"
              >
                &ldquo;
              </p>
              <p class="leading-relaxed flex-1 text-text">{t.quote}</p>
              <div class="mt-8 flex items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                  <Image
                    src={t.photo}
                    width={56}
                    height={56}
                    alt={t.name}
                    class="rounded-full object-cover w-14 h-14 shrink-0"
                  />
                  <div>
                    <p class="font-bold text-text-dark">{t.name}</p>
                    <p class="text-sm text-text">{t.title}</p>
                    <p class="text-sm text-text/60">{t.company}</p>
                  </div>
                </div>
                <img
                  src={t.logo}
                  alt={t.logoAlt}
                  class="max-h-[36px] w-auto object-contain shrink-0 opacity-70"
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <Cta cta={cta} />
</Base>
