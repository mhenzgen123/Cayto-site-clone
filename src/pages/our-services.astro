      <div class="text-center mb-12">
        <h1 class="font-bold">Our Selection Process</h1>
        <p class="mt-3">Every candidate who reaches your inbox has cleared all six stages.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {selectionSteps.map((s) => <ProcessStep step={s.step} title={s.title} description={s.description} />)}
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <!-- Talent Tiers — Tabs -->
  <!-- AI-Generated -->
  <section class="section">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="font-bold">Explore Our Talent by Role & Skill Set</h2>
      </div>
      <div class="tab">
        <ul class="tab-nav justify-center">
          {
            tiers.map((tier, i) => (
              <li class={`tab-nav-item${i === 0 ? " active" : ""}`}>{tier.label}</li>
            ))
          }
        </ul>
        {
          tiers.map((tier, i) => (
            <div class={`tab-content-panel${i === 0 ? " active" : ""}`}>
              <div class="grid gap-8 md:grid-cols-3 pt-8">
                <div>
                  <h5 class="font-bold mb-3">Typical Roles</h5>
                  <ul class="list-none pl-0 space-y-2">
                    {tier.roles.map((role) => (
                      <li class="relative pl-5 text-text before:absolute before:left-0 before:top-[10px] before:h-2 before:w-2 before:rounded-full before:bg-primary before:content-['']">
                        {role}
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h5 class="font-bold mb-3">Experience</h5>
                  <ul class="list-none pl-0 space-y-2">
                    {tier.experience.map((item) => (
                      <li class="relative pl-5 text-text before:absolute before:left-0 before:top-[10px] before:h-2 before:w-2 before:rounded-full before:bg-primary before:content-['']">
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h5 class="font-bold mb-3">Certifications</h5>
                  <ul class="list-none pl-0 space-y-2">
                    {tier.certifications.map((cert) => (
                      <li class="relative pl-5 text-text before:absolute before:left-0 before:top-[10px] before:h-2 before:w-2 before:rounded-full before:bg-primary before:content-['']">
                        {cert}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Specialized Skill Sets -->
      <div class="inset-panel mt-10 rounded-xl bg-light p-8 border border-border">
        <h4 class="font-bold mb-4">Specialized Skill Sets</h4>
        <ul class="grid gap-2 sm:grid-cols-2 md:grid-cols-4 list-none pl-0">
          {
            skillSets.map((role) => (
              <li class="relative pl-5 text-text before:absolute before:left-0 before:top-[10px] before:h-2 before:w-2 before:rounded-full before:bg-primary before:content-['']">
                {role}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
  <!-- End AI-Generated -->

  <!-- Tab interactivity — progressive enhancement, no framework dependency -->
  <!-- AI-Generated -->
  <script>
    /** Wires up tab navigation within .tab components.
     *  Activates the clicked nav item and its corresponding content panel by index.
     *
     *  Runs both immediately (handles the case where this module script loads AFTER
     *  astro:page-load has already fired for the current navigation) and on every
     *  future astro:page-load (handles ClientRouter soft-navigations).
     *  Using both guards against Astro module script / event timing edge cases.
     */
    function initTabs() {
      const navItems = document.querySelectorAll<HTMLElement>(".tab-nav-item");
      const panels = document.querySelectorAll<HTMLElement>(".tab-content-panel");
      if (!navItems.length) return;
      navItems.forEach((item, index) => {
        item.addEventListener("click", () => {
          navItems.forEach((n) => n.classList.remove("active"));
          panels.forEach((p) => p.classList.remove("active"));
          item.classList.add("active");
          panels[index]?.classList.add("active");
        });
      });
    }

    // Immediate call: handles when this script loads after astro:page-load
    initTabs();
    // Listener: handles every subsequent soft-navigation to this page
    document.addEventListener("astro:page-load", initTabs);
  </script>
  <!-- End AI-Generated -->

  <!-- Testimonials -->
  <!-- AI-Generated -->
  <section class="section bg-dot-grid border-y border-border">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="font-bold">What Our Clients Say</h2>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
